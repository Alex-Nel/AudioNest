<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AudioNest.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="IconPlay">M5,3 L21,12 L5,21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPause">M5,4 H10 V20 H5 Z M14,4 H19 V20 H14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M4,4 H20 V20 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBackward">M3,4 H6 V20 H3 Z M20,4 V20 L8,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconForward">M18,4 H21 V20 H18 Z M4,4 L16,12 L4,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRecord">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z</StreamGeometry>
      <StreamGeometry x:Key="IconZoomIn">F0 M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 Z M15,17 L17,15 L23,21 L21,23 Z M9,6 H11 V9 H14 V11 H11 V14 H9 V11 H6 V9 H9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconZoomOut">F0 M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 Z M15,17 L17,15 L23,21 L21,23 Z M6,9 H14 V11 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSpeaker">M2,9 H6 L12,4 V20 L6,15 H2 Z M15,7 L17,5 Q24,12 17,19 L15,17 Q20,12 15,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMic">M8,5 A4,4 0 0 1 16,5 V12 A4,4 0 0 1 8,12 Z M5,11 H7 V12 A5,5 0 0 0 17,12 V11 H19 V12 A7,7 0 0 1 13,19 V21 H17 V23 H7 V21 H11 V19 A7,7 0 0 1 5,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSelection">M4,2 V21 L9,16 L13,23 L16,21 L12,14 H20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRazor">F0 M4,3 H20 V5 H22 V8 H20 V16 H22 V19 H20 V21 H4 V19 H2 V16 H4 V8 H2 V5 H4 Z M7,10 H10 V8 H14 V10 H17 V14 H14 V16 H10 V14 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconImport">M10,2 H14 V12 L18,8 L21,11 L12,20 L3,11 L6,8 L10,12 Z M2,19 H5 V22 H19 V19 H22 V24 H2 Z</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EditorBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="EditorPanel">#F5F5F5</SolidColorBrush>
          <SolidColorBrush x:Key="EditorBorder">#D9D9D9</SolidColorBrush>
          <SolidColorBrush x:Key="InspectorDivider">#B5B8BC</SolidColorBrush>
          <SolidColorBrush x:Key="EditorText">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="EditorMuted">#666A70</SolidColorBrush>
          <SolidColorBrush x:Key="EditorSelected">#E6EFF8</SolidColorBrush>
          <SolidColorBrush x:Key="EditorAccent">#2864A0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="EditorBackground">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="EditorPanel">#292A2D</SolidColorBrush>
          <SolidColorBrush x:Key="EditorBorder">#45474B</SolidColorBrush>
          <SolidColorBrush x:Key="InspectorDivider">#686B72</SolidColorBrush>
          <SolidColorBrush x:Key="EditorText">#F0F0F0</SolidColorBrush>
          <SolidColorBrush x:Key="EditorMuted">#B4B7BE</SolidColorBrush>
          <SolidColorBrush x:Key="EditorSelected">#33475B</SolidColorBrush>
          <SolidColorBrush x:Key="EditorAccent">#8CBDFA</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.track, ToggleButton.track">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="11" />
    </Style>
    <Style Selector="Button.editorControl, ToggleButton.editorControl">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="9" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,2,4,2" />
    </Style>
    <Style Selector="Button.toolbarText, ToggleButton.toolbarText">
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="MenuItem.topLevel">
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditorAccent}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
