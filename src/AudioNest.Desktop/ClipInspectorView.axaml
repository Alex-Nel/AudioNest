<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AudioNest.Desktop"
             xmlns:a="using:Avalonia.Automation"
             x:Class="AudioNest.Desktop.ClipInspectorView" x:DataType="local:ClipInspectorViewModel">
  <UserControl.Resources>
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
    <GridLength x:Key="SliderPreContentMargin">8</GridLength>
    <GridLength x:Key="SliderPostContentMargin">8</GridLength>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.inspectorDivider">
      <Setter Property="Height" Value="5" />
      <Setter Property="Background" Value="{DynamicResource InspectorDivider}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.globalProperty">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.globalProperty">
      <!-- The Fluent indicator row needs its theme minimum (normally 32 px).
           Keep height automatic so its 20 px box cannot be clipped. -->
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.effectHeader">
      <Setter Property="Background" Value="{DynamicResource EffectHeaderBackground}" />
    </Style>
    <Style Selector="Border.effectHeader.dragging">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="ToggleButton.effectExpand">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="26" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="2">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.effectExpand:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditorBorder}" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <!-- Each effect owns its editor template; multi-parameter effects can supply
         dedicated views without changing the inspector's section container. -->
    <DataTemplate DataType="{x:Type local:GainEffectEditorViewModel}" x:DataType="local:GainEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Amplitude" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="0" Maximum="16" Value="{Binding Value}"
               TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.5"
               a:AutomationProperties.Name="Clip gain" />
        <TextBlock Text="0 silences · 1 is unchanged" FontSize="11" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:LimiterEffectEditorViewModel}" x:DataType="local:LimiterEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Ceiling" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="0.01" Maximum="1" Value="{Binding Value}"
               TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
               a:AutomationProperties.Name="Clip limiter ceiling" />
        <ItemsControl ItemsSource="{Binding Parameters}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:EffectParameterViewModel}" x:DataType="local:EffectParameterViewModel">
      <StackPanel Spacing="4" Margin="0,0,0,6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12" />
        </Grid>
        <local:EffectParameterSlider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                                    TickFrequency="{Binding Step}" SmallChange="{Binding Step}" IsSnapToTickEnabled="True"
                                    a:AutomationProperties.Name="{Binding Name}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:CompressorEffectEditorViewModel}" x:DataType="local:CompressorEffectEditorViewModel">
      <ItemsControl ItemsSource="{Binding Parameters}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:NormalizerEffectEditorViewModel}" x:DataType="local:NormalizerEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Target peak" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="0.01" Maximum="1" Value="{Binding Value}" TickFrequency="0.01"
                                    SmallChange="0.01" IsSnapToTickEnabled="True" a:AutomationProperties.Name="Target peak" />
        <TextBlock Text="Analyzes the full clip or track before playback. Not loudness/LUFS normalization."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:NoiseReductionEffectEditorViewModel}" x:DataType="local:NoiseReductionEffectEditorViewModel">
      <StackPanel Spacing="6">
        <ItemsControl ItemsSource="{Binding Parameters}" />
        <TextBlock Text="Multiband suppression below an adjustable noise floor. Quiet detail can be reduced; no learned noise profile."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:AmplifierEffectEditorViewModel}" x:DataType="local:AmplifierEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Amplification" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="-60" Maximum="36" Value="{Binding Value}" TickFrequency="0.5"
                                    SmallChange="0.5" IsSnapToTickEnabled="True" a:AutomationProperties.Name="Amplification in dB" />
        <TextBlock Text="{Binding MultiplierText}" FontSize="11" Foreground="{DynamicResource EditorMuted}" />
        <TextBlock Text="Boosts or attenuates without automatic normalization. Add a limiter afterward to control peaks."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ReverbEffectEditorViewModel}" x:DataType="local:ReverbEffectEditorViewModel">
      <StackPanel Spacing="6">
        <ItemsControl ItemsSource="{Binding Parameters}" />
        <TextBlock Text="Algorithmic room reverb. Clip tails stop at the clip edge; track tails stop at the project end."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:EchoEffectEditorViewModel}" x:DataType="local:EchoEffectEditorViewModel">
      <StackPanel Spacing="6">
        <ItemsControl ItemsSource="{Binding Parameters}" />
        <TextBlock Text="Repeating delay, up to 30 seconds of tail. Clip tails stop at the clip edge; track tails stop at the project end."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:DistortionEffectEditorViewModel}" x:DataType="local:DistortionEffectEditorViewModel">
      <StackPanel Spacing="6">
        <ItemsControl ItemsSource="{Binding Parameters}" />
        <TextBlock Text="Soft saturation, not an amp/cabinet model. High drive can alias; wet output trims only the distorted signal."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid>
  <ScrollViewer x:Name="InspectorScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="0,12">
      <TextBlock x:Name="InspectorTitle" Text="{Binding Title}" Classes="section" FontSize="12" Margin="12,0" />
      <!-- Permanent, non-removable global section. Duration/source bounds remain
           read-only; timeline trimming owns source-region edits. -->
      <StackPanel Spacing="6" Margin="12,0">
        <TextBlock Text="Global properties" FontWeight="SemiBold" FontSize="12" />
        <StackPanel DataContext="{Binding Properties}" x:DataType="local:ClipPropertiesViewModel" Spacing="5">
          <TextBlock Text="Name" FontSize="11" />
          <TextBox x:Name="ClipNameEditor" Classes="globalProperty" Text="{Binding Name}" MaxLength="120" IsEnabled="{Binding CanEdit}"
                   a:AutomationProperties.Name="{Binding NameLabel}" />
          <WrapPanel>
            <CheckBox x:Name="ClipMuteBox" Classes="globalProperty" Content="Muted" IsChecked="{Binding Muted}" IsEnabled="{Binding CanEdit}" Margin="0,0,12,0" />
            <CheckBox x:Name="ClipLockBox" Classes="globalProperty" Content="{Binding SecondaryStateLabel}" IsChecked="{Binding SecondaryState}" IsEnabled="{Binding CanEdit}"
                      ToolTip.Tip="{Binding SecondaryStateHint}" />
          </WrapPanel>
          <TextBlock Text="Timeline start (seconds)" FontSize="11" IsVisible="{Binding ShowTimelineStart}" />
          <TextBox x:Name="ClipStartEditor" Classes="globalProperty" Text="{Binding StartText}" IsEnabled="{Binding CanMove}" IsVisible="{Binding ShowTimelineStart}"
                   a:AutomationProperties.Name="Clip start in seconds" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#BA4545" TextWrapping="Wrap" FontSize="11" />
          <Grid ColumnDefinitions="32,*,45">
            <TextBlock Text="Vol" FontSize="11" VerticalAlignment="Center" />
            <local:ClipMixSlider x:Name="ClipVolumeSlider" Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="2"
                   TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" IsEnabled="{Binding CanEdit}"
                   a:AutomationProperties.Name="{Binding VolumeLabel}" ToolTip.Tip="Volume: 0 is silence, 1 is original, 2 is twice the amplitude" />
            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="32,*,45">
            <TextBlock Text="Pan" FontSize="11" VerticalAlignment="Center" />
            <local:ClipMixSlider x:Name="ClipPanSlider" Grid.Column="1" IsPan="True" Value="{Binding Pan}" Minimum="-1" Maximum="1"
                   TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" IsEnabled="{Binding CanPan}"
                   a:AutomationProperties.Name="{Binding PanLabel}" ToolTip.Tip="Stereo balance; disabled on mono tracks" />
            <TextBlock Grid.Column="2" Text="{Binding BalanceText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" LineHeight="18" FontSize="11" />
      </StackPanel>
      <Border Classes="inspectorDivider" />
      <TextBlock Text="No effects. Use the Effects menu to add an effect."
                 IsVisible="{Binding !HasEffects}" TextWrapping="Wrap"
                 Foreground="{DynamicResource EditorMuted}" FontSize="12" Margin="12,0" />
      <ItemsControl x:Name="EffectSections" ItemsSource="{Binding Effects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ClipEffectEditorViewModel">
            <StackPanel Classes="effectSection" Margin="0,0,0,12">
              <Border Classes="effectHeader" Classes.dragging="{Binding IsReordering}" Margin="8,0" Padding="4"
                      CornerRadius="2" IsEnabled="{Binding CanEdit}" Cursor="SizeAll" ToolTip.Tip="Drag this header to reorder effects">
                <Grid Classes="effectHeading" ColumnDefinitions="Auto,*,Auto">
                  <ToggleButton Classes="effectExpand" Content="{Binding ExpansionGlyph}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                ToolTip.Tip="{Binding ExpansionHint}" a:AutomationProperties.Name="{Binding ExpansionHint}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="effectName" FontWeight="SemiBold" Margin="4,0"
                             VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Content="×" Classes="track removeEffect" Command="{Binding Remove}" Cursor="Arrow"
                          ToolTip.Tip="{Binding RemoveHint}" a:AutomationProperties.Name="{Binding RemoveHint}" />
                </Grid>
              </Border>
              <StackPanel Classes="effectBody" Spacing="8" IsEnabled="{Binding CanEdit}" IsVisible="{Binding IsExpanded}" Margin="12,8,12,0">
                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" />
              </StackPanel>
              <Border Classes="inspectorDivider" Margin="0,12,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  <Border x:Name="EffectDropIndicator" Height="3" Background="{DynamicResource EditorAccent}" IsVisible="False"
          IsHitTestVisible="False" VerticalAlignment="Top" ZIndex="10" />
  </Grid>
</UserControl>
