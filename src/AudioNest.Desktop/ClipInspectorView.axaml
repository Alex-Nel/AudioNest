<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AudioNest.Desktop"
             xmlns:a="using:Avalonia.Automation"
             x:Class="AudioNest.Desktop.ClipInspectorView" x:DataType="local:ClipInspectorViewModel">
  <UserControl.DataTemplates>
    <!-- Each effect owns its editor template; multi-parameter effects can supply
         dedicated views without changing the inspector's section container. -->
    <DataTemplate DataType="{x:Type local:GainEffectEditorViewModel}" x:DataType="local:GainEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Amplitude" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="0" Maximum="16" Value="{Binding Value}"
               TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.5"
               a:AutomationProperties.Name="Clip gain" />
        <TextBlock Text="0 silences · 1 is unchanged" FontSize="11" Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:LimiterEffectEditorViewModel}" x:DataType="local:LimiterEffectEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Ceiling" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" />
        </Grid>
        <local:EffectParameterSlider Minimum="0.01" Maximum="1" Value="{Binding Value}"
               TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"
               a:AutomationProperties.Name="Clip limiter ceiling" />
        <TextBlock Text="Hard-clips peaks above this ceiling." FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource EditorMuted}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="16">
      <TextBlock Text="CLIP" Classes="section" />
      <!-- Permanent, non-removable global section. Duration/source bounds remain
           read-only; timeline trimming owns source-region edits. -->
      <Border BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="Global properties" FontWeight="SemiBold" />
          <StackPanel DataContext="{Binding Properties}" x:DataType="local:ClipPropertiesViewModel" Spacing="8">
            <TextBlock Text="Name" FontSize="11" />
            <TextBox x:Name="ClipNameEditor" Text="{Binding Name}" MaxLength="120" IsEnabled="{Binding CanEdit}"
                     a:AutomationProperties.Name="Clip name" />
            <TextBlock Text="Timeline start (seconds)" FontSize="11" />
            <NumericUpDown x:Name="ClipStartEditor" Value="{Binding StartSeconds}" Minimum="0"
                           Increment="0.1" FormatString="0.000000" IsEnabled="{Binding CanEdit}"
                           a:AutomationProperties.Name="Clip start in seconds" />
            <TextBlock Text="{Binding Error}" Foreground="#BA4545" TextWrapping="Wrap" FontSize="11" />
            <Button x:Name="ApplyClipPropertiesButton" Content="Apply properties" Command="{Binding Apply}" />
          </StackPanel>
          <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" LineHeight="20" FontSize="12" />
          <WrapPanel>
            <Button Content="← 0.1 s" Command="{Binding NudgeLeft}" Margin="0,0,6,6" />
            <Button Content="0.1 s →" Command="{Binding NudgeRight}" Margin="0,0,6,6" />
          </WrapPanel>
          <Button Content="Split at playhead" Command="{Binding Split}" />
          <Button Content="Delete selected clips" Command="{Binding Delete}" />
        </StackPanel>
      </Border>
      <TextBlock Text="EFFECTS · IN PROCESSING ORDER" Classes="section" TextWrapping="Wrap" />
      <TextBlock Text="No clip effects. Add a section below or use the Effects menu."
                 IsVisible="{Binding !HasEffects}" TextWrapping="Wrap"
                 Foreground="{DynamicResource EditorMuted}" FontSize="12" />
      <ItemsControl x:Name="EffectSections" ItemsSource="{Binding Effects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ClipEffectEditorViewModel">
            <Border Padding="10" Margin="0,0,0,10" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1"
                    IsEnabled="{Binding CanEdit}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="×" Classes="track" Command="{Binding Remove}"
                          ToolTip.Tip="Remove this effect" a:AutomationProperties.Name="Remove clip effect" />
                </Grid>
                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel>
        <Button Content="Add gain" Command="{Binding AddGain}" Margin="0,0,6,6" />
        <Button Content="Add limiter" Command="{Binding AddLimiter}" Margin="0,0,6,6" />
      </WrapPanel>
      <Border Height="1" Background="{DynamicResource EditorBorder}" />
      <StackPanel Spacing="8">
        <TextBlock Text="TRACK" Classes="section" />
        <TextBlock Text="{Binding TrackName}" TextWrapping="Wrap" />
        <Button Content="Toggle track limiter" Command="{Binding TrackLimiter}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
