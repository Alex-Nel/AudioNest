<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AudioNest.Desktop"
             x:Class="AudioNest.Desktop.ClipInspectorView" x:DataType="local:ClipInspectorViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="16">
      <StackPanel Spacing="8">
        <TextBlock Text="CLIP" Classes="section" />
        <TextBlock Text="{Binding ClipName}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" LineHeight="22" FontSize="12" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource EditorBorder}" />
      <Expander Header="Effects" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <TextBlock Text="No clip effects. Add gain or a limiter below, or use the Effects menu."
                     IsVisible="{Binding !HasEffects}" TextWrapping="Wrap"
                     Foreground="{DynamicResource EditorMuted}" FontSize="12" />
          <ItemsControl ItemsSource="{Binding Effects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ClipEffectRow">
                <Border Padding="8" Margin="0,0,0,6" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Margin="8,0,0,0" />
                    <TextBlock Grid.Row="1" Text="{Binding State}" Foreground="{DynamicResource EditorMuted}" FontSize="11" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="−3 dB" Command="{Binding Quieter}" />
            <Button Content="+3 dB" Command="{Binding Louder}" />
          </StackPanel>
          <Button Content="Toggle clip limiter" Command="{Binding ToggleLimiter}" />
        </StackPanel>
      </Expander>
      <Border Height="1" Background="{DynamicResource EditorBorder}" />
      <Expander Header="Clip actions" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="← 0.1 s" Command="{Binding NudgeLeft}" />
            <Button Content="0.1 s →" Command="{Binding NudgeRight}" />
          </StackPanel>
          <Button Content="Split at playhead" Command="{Binding Split}" />
          <Button Content="Delete clip" Command="{Binding Delete}" />
        </StackPanel>
      </Expander>
      <Border Height="1" Background="{DynamicResource EditorBorder}" />
      <StackPanel Spacing="8">
        <TextBlock Text="TRACK" Classes="section" />
        <TextBlock Text="{Binding TrackName}" TextWrapping="Wrap" />
        <Button Content="Toggle track limiter" Command="{Binding TrackLimiter}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
