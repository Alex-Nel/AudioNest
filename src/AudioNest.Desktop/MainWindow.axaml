<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudioNest.Desktop"
        x:Class="AudioNest.Desktop.MainWindow" x:DataType="local:MainViewModel"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        Background="#101918">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Padding="24,18" Background="#162320" BorderBrush="#2B3B36" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#A2E5B5" CornerRadius="9" Width="36" Height="36">
            <TextBlock Text="≋" Foreground="#162820" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="AudioNest" FontWeight="SemiBold" FontSize="23" />
            <TextBlock Text="A little room for your next big sound." Foreground="#94A79E" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
          <Button Content="New" Click="NewClick" />
          <Button Content="Open…" Click="OpenClick" />
          <Button Content="Save" Click="SaveClick" />
          <Button Content="Save as…" Click="SaveAsClick" />
          <Button Content="Export WAV" Click="ExportClick" Background="#345B44" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="20,12" BorderBrush="#2B3B36" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding PlayLabel}" Click="PlayClick" IsEnabled="{Binding CanEdit}" Background="#A2E5B5" Foreground="#132B1C" MinWidth="70" />
          <Button Content="Stop" Click="StopClick" />
          <Button Content="{Binding RecordLabel}" Click="RecordClick" IsEnabled="{Binding CanEdit}" Foreground="#FFB7AC" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontFamily="monospace" FontSize="22" Margin="24,0" VerticalAlignment="Center" Foreground="#CEE9D7" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEdit}">
          <Button Content="Import audio…" Click="ImportClick" />
          <Button Content="+ Track" Click="AddTrackClick" />
          <Button Content="−" Click="ZoomOutClick" ToolTip.Tip="Zoom out" />
          <Button Content="+" Click="ZoomInClick" ToolTip.Tip="Zoom in" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,256">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,12" Background="#14201C">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="ARRANGEMENT" Classes="section" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Undo" Click="UndoClick" IsEnabled="{Binding CanUndo}" />
              <Button Content="Redo" Click="RedoClick" IsEnabled="{Binding CanRedo}" />
              <Button Content="Split  S" Click="SplitClick" IsEnabled="{Binding CanEdit}" />
              <Button Content="Delete" Click="DeleteClick" IsEnabled="{Binding CanEdit}" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid Width="{Binding TimelineWidth}" Height="{Binding TimelineHeight}">
            <local:TimelineControl />
            <local:PlayheadControl IsHitTestVisible="False" />
          </Grid>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="Space  play / pause    ·    S  split at cursor    ·    Delete  remove clip    ·    Drag clips to move" Foreground="#7E978C" FontSize="11" Margin="20,12" />
      </Grid>
      <Border Grid.Column="1" Background="#17231F" BorderBrush="#2B3B36" BorderThickness="1,0,0,0" Padding="20">
        <ScrollViewer>
          <StackPanel Spacing="14" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="CLIP INSPECTOR" Classes="section" />
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" LineHeight="23" />
            <TextBlock Text="Non-destructive gain" Foreground="#9AB0A2" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="−3 dB" Click="ClipQuieterClick" />
              <Button Content="+3 dB" Click="ClipLouderClick" />
            </StackPanel>
            <Button Content="Toggle limiter · −0.9 dB" Click="ClipLimiterClick" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="← 0.1 s" Click="NudgeLeftClick" />
              <Button Content="0.1 s →" Click="NudgeRightClick" />
            </StackPanel>
            <Border Height="1" Background="#304037" Margin="0,8" />
            <TextBlock Text="TRACK" Classes="section" />
            <TextBlock Text="{Binding TrackText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Mute" Click="MuteClick" />
              <Button Content="Solo" Click="SoloClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="−3 dB" Click="TrackQuieterClick" />
              <Button Content="+3 dB" Click="TrackLouderClick" />
            </StackPanel>
            <Button Content="Toggle track limiter" Click="TrackLimiterClick" HorizontalAlignment="Stretch" />
            <Border Height="1" Background="#304037" Margin="0,8" />
            <TextBlock Text="YOUR ORIGINALS STAY SAFE" Classes="section" />
            <TextBlock Text="Clips point to source audio. Split a clip to process just one segment. Every edit can be undone." TextWrapping="Wrap" Foreground="#9AB0A2" FontSize="12" LineHeight="20" />
            <TextBlock Text="MVP · gain + hard limiter&#x0a;Advanced DSP and VST hosting are not included yet." TextWrapping="Wrap" Foreground="#738D7C" FontSize="11" LineHeight="18" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Padding="20,10" Background="#1D2D25" BorderBrush="#304037" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding ProjectInfo}" Foreground="#94B09D" FontSize="12" Margin="20,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
