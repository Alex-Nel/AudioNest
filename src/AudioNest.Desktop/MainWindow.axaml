<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudioNest.Desktop"
        xmlns:a="using:Avalonia.Automation"
        x:Class="AudioNest.Desktop.MainWindow" x:DataType="local:MainViewModel"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="760" MinHeight="480" WindowState="Maximized"
        Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorText}">
  <Grid RowDefinitions="Auto,Auto,*,26">
    <Menu x:Name="EditorMenuBar" Height="24" Background="{DynamicResource EditorPanel}" />
    <Border Grid.Row="1" Padding="10,7" Background="{DynamicResource EditorPanel}"
            BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,1,0,1">
      <Grid x:Name="ToolbarGrid" ColumnDefinitions="Auto,Auto,*,5,300">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="SkipBackButton" Classes="transport" Click="SkipBackClick" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Skip to start (Home)" a:AutomationProperties.Name="Skip to start">
            <PathIcon Data="{StaticResource IconBackward}" />
          </Button>
          <Button x:Name="SkipForwardButton" Classes="transport" Click="SkipForwardClick" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Skip to end (End)" a:AutomationProperties.Name="Skip to end">
            <PathIcon Data="{StaticResource IconForward}" />
          </Button>
          <Button x:Name="PlayButton" Classes="transport" Click="PlayClick" IsEnabled="{Binding CanPlay}" ToolTip.Tip="Play (Space)" a:AutomationProperties.Name="Play">
            <PathIcon Data="{StaticResource IconPlay}" Foreground="#238544" />
          </Button>
          <Button x:Name="PauseButton" Classes="transport" Click="PauseClick" IsEnabled="{Binding CanPause}" ToolTip.Tip="Pause (Space)" a:AutomationProperties.Name="Pause">
            <PathIcon Data="{StaticResource IconPause}" />
          </Button>
          <Button x:Name="StopButton" Classes="transport" Click="StopClick" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Stop" a:AutomationProperties.Name="Stop">
            <PathIcon Data="{StaticResource IconStop}" />
          </Button>
          <Button x:Name="RecordButton" Classes="transport" Click="RecordClick" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding RecordLabel}" a:AutomationProperties.Name="Record">
            <PathIcon Data="{StaticResource IconRecord}" Foreground="#D84040" />
          </Button>
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="34" Margin="10,0" Background="{DynamicResource EditorBorder}" />
        <WrapPanel x:Name="EditingTools" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="ImportButton" Classes="editorControl" Click="ImportClick" IsEnabled="{Binding CanEdit}"
                  ToolTip.Tip="Import audio (Ctrl/Cmd+I)" a:AutomationProperties.Name="Import audio">
            <PathIcon Data="{StaticResource IconImport}" />
          </Button>
          <ToggleButton x:Name="SelectionToolButton" Classes="editorControl" Margin="10,2,4,2" IsChecked="{Binding IsSelectionTool, Mode=OneWay}" Command="{Binding SelectionTool}"
                        ToolTip.Tip="Selection tool (V): move clips and trim edges" a:AutomationProperties.Name="Selection tool">
            <PathIcon Data="{StaticResource IconSelection}" />
          </ToggleButton>
          <ToggleButton x:Name="RazorToolButton" Classes="editorControl" IsChecked="{Binding IsRazorTool, Mode=OneWay}" Command="{Binding RazorTool}"
                        ToolTip.Tip="Razor tool (C): split at the clicked frame" a:AutomationProperties.Name="Razor tool">
            <PathIcon Data="{StaticResource IconRazor}" />
          </ToggleButton>
          <ToggleButton x:Name="SnapButton" Classes="editorControl toolbarText" Margin="10,2,4,2" Content="Snap" IsChecked="{Binding IsSnappingEnabled}"
                        ToolTip.Tip="Snap moving/resized clip edges across tracks · left Shift inverts · Alt bypasses" />
          <Button x:Name="ZoomOutButton" Classes="editorControl" Margin="10,2,4,2" Click="ZoomOutClick" ToolTip.Tip="Zoom out around playhead" a:AutomationProperties.Name="Zoom out">
            <PathIcon Data="{StaticResource IconZoomOut}" />
          </Button>
          <Button x:Name="ZoomInButton" Classes="editorControl" Click="ZoomInClick" ToolTip.Tip="Zoom in around playhead" a:AutomationProperties.Name="Zoom in">
            <PathIcon Data="{StaticResource IconZoomIn}" />
          </Button>
          <Button x:Name="FitButton" Classes="editorControl toolbarText" Content="Fit" Click="FitClick" ToolTip.Tip="Fit project to available width" />
        </WrapPanel>
        <GridSplitter x:Name="MeterSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource EditorBorder}"
                      a:AutomationProperties.Name="Resize audio meters" />
        <Grid x:Name="LiveMeters" Grid.Column="4" Margin="6,0,0,0" RowDefinitions="18,18" ColumnDefinitions="18,*,54" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconSpeaker}" Width="13" Height="13" ToolTip.Tip="Timeline playback" />
          <local:AudioMeterControl x:Name="OutputMeter" Grid.Column="1" Height="10" Level="{Binding OutputLevel}" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding OutputMeterText}" a:AutomationProperties.Name="Timeline output peak meter" />
          <TextBlock Grid.Column="2" Text="{Binding OutputDecibels}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <PathIcon Grid.Row="1" Data="{StaticResource IconMic}" Width="13" Height="13" ToolTip.Tip="Microphone (recording only)" />
          <local:AudioMeterControl x:Name="InputMeter" Grid.Row="1" Grid.Column="1" Height="10" Level="{Binding InputLevel}" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding InputMeterText}" a:AutomationProperties.Name="Recording microphone peak meter" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding InputDecibels}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="EditorBody" Grid.Row="2" ColumnDefinitions="*,5,280">
      <Grid x:Name="TimelineArea" RowDefinitions="32,*,Auto" MinWidth="0">
        <Grid ColumnDefinitions="228,*" Background="{DynamicResource EditorPanel}">
          <Border BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,0,1,1">
            <TextBlock Text="TRACKS" Classes="section" Margin="12,0" VerticalAlignment="Center" />
          </Border>
          <ScrollViewer x:Name="RulerScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <local:TimelineRulerControl x:Name="TimelineRuler" Width="{Binding TimelineWidth}" Height="32"
                                        ToolTip.Tip="Drag to seek · left Shift snaps to clip boundaries" />
          </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="TracksVerticalScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="228,*" Background="{DynamicResource EditorPanel}">
            <Border x:Name="TrackHeadersPanel" Background="{DynamicResource EditorPanel}">
              <ItemsControl ItemsSource="{Binding TrackHeaders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:TrackHeaderViewModel">
                    <local:TrackHeaderView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <Grid Width="{Binding TimelineWidth}" Height="{Binding TimelineHeight}">
                <local:TimelineControl x:Name="TimelineClips" />
                <local:PlayheadControl IsHitTestVisible="False" />
              </Grid>
            </ScrollViewer>
          </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="228,*" Background="{DynamicResource EditorPanel}">
          <ScrollBar x:Name="TimelineHorizontalBar" Grid.Column="1" Orientation="Horizontal" />
        </Grid>
      </Grid>
      <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource EditorBorder}"
                    a:AutomationProperties.Name="Resize clip inspector" />
      <Border x:Name="Inspector" Grid.Column="2" Background="{DynamicResource EditorPanel}">
        <local:ClipInspectorView DataContext="{Binding Inspector}" />
      </Border>
    </Grid>
    <Border Grid.Row="3" Padding="10,2" Background="{DynamicResource EditorPanel}" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusBarText}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" />
        <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontFamily="monospace" FontSize="12" Margin="16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding PositionFramesText}" FontSize="11" Foreground="{DynamicResource EditorMuted}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
