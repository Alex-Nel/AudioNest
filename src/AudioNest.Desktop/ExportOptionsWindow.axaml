<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudioNest.Desktop" xmlns:h="using:AudioNest.Hardware"
        x:Class="AudioNest.Desktop.ExportOptionsWindow" x:DataType="local:ExportOptionsViewModel"
        Title="Export" Width="560" Height="300" MinWidth="440" MinHeight="280"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock Text="Export audio" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox x:Name="OutputPathBox" Text="{Binding Path}" Watermark="Output file location" />
      <Button Grid.Column="1" Content="Browse…" Click="BrowseClick" Margin="8,0,0,0" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="80,*">
      <TextBlock Text="Format" VerticalAlignment="Center" />
      <ComboBox x:Name="FormatBox" Grid.Column="1" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="h:AudioFileType"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,12" Foreground="#BA4545" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="CancelClick" IsCancel="True" />
      <Button x:Name="ExportButton" Content="Export" Click="ExportClick" IsEnabled="{Binding CanExport}" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
