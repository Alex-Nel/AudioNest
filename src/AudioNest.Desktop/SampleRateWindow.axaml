<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AudioNest.Desktop"
        xmlns:a="using:Avalonia.Automation"
        x:Class="AudioNest.Desktop.SampleRateWindow" x:DataType="local:SampleRateViewModel"
        Title="Project sample rate" Width="470" Height="310" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock Text="Project sample rate" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <AutoCompleteBox x:Name="SampleRateBox" Text="{Binding Text, Mode=TwoWay}" ItemsSource="{Binding Presets}"
                       MinimumPrefixLength="0" FilterMode="None" IsTextCompletionEnabled="False"
                       a:AutomationProperties.Name="Project sample rate in Hz" />
      <Button x:Name="SampleRatePresetsButton" Grid.Column="1" Content="▾" Click="PresetsClick"
              a:AutomationProperties.Name="Show common sample rates" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="#BA4545" TextWrapping="Wrap" Margin="0,8" />
    <TextBlock Grid.Row="3" Text="Choose a common rate or type your own (8–192 kHz). Audio is rebuilt from original media; timing and pitch are preserved to the nearest sample. Playback will pause. This change can be undone."
               TextWrapping="Wrap" Foreground="{DynamicResource EditorMuted}" Margin="0,4,0,12" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="CancelClick" IsCancel="True" />
      <Button x:Name="ApplySampleRateButton" Content="Apply" Click="ApplyClick" IsEnabled="{Binding CanApply}" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
