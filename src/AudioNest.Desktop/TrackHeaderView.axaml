<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AudioNest.Desktop"
             xmlns:a="using:Avalonia.Automation"
             x:Class="AudioNest.Desktop.TrackHeaderView"
             x:DataType="local:TrackHeaderViewModel" Height="{Binding Height}"
             PointerPressed="SelectTrack">
  <UserControl.Resources>
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
    <GridLength x:Key="SliderPreContentMargin">8</GridLength>
    <GridLength x:Key="SliderPostContentMargin">8</GridLength>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.trackSurface">
      <Setter Property="Background" Value="{DynamicResource EditorPanel}" />
    </Style>
    <Style Selector="Border.trackSurface.selected">
      <Setter Property="Background" Value="{DynamicResource EditorSelected}" />
    </Style>
    <Style Selector="Thumb.trackResize:pointerover, Thumb.trackResize:pressed">
      <Setter Property="Background" Value="{DynamicResource EditorAccent}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="trackSurface" Classes.selected="{Binding IsSelected}"
          BorderBrush="{DynamicResource EditorBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="*,6">
    <Grid RowDefinitions="28,28,40,40" Margin="10,8,10,0">
      <Grid ColumnDefinitions="Auto,*">
        <Button Content="×" Classes="track" Command="{Binding Delete}" Margin="0,0,7,0"
                a:AutomationProperties.Name="Delete track" ToolTip.Tip="Delete track" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="Mute" Classes="track" IsChecked="{Binding IsMuted, Mode=OneWay}"
                        Command="{Binding Mute}" a:AutomationProperties.Name="Mute track" />
          <ToggleButton Content="Solo" Classes="track" IsChecked="{Binding IsSolo, Mode=OneWay}"
                        Command="{Binding Solo}" a:AutomationProperties.Name="Solo track" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ChannelText}" FontSize="10" VerticalAlignment="Center"
                   Foreground="{DynamicResource EditorMuted}" />
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="32,*,45" VerticalAlignment="Center">
        <TextBlock Text="Vol" Foreground="{DynamicResource EditorMuted}" VerticalAlignment="Center" FontSize="11" />
        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Volume}"
                TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" IsEnabled="{Binding CanEdit}"
                a:AutomationProperties.Name="Track volume" ToolTip.Tip="{Binding VolumeHint}" />
        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="3" ColumnDefinitions="32,*,45" VerticalAlignment="Center">
        <TextBlock Text="Pan" Foreground="{DynamicResource EditorMuted}" VerticalAlignment="Center" FontSize="11" />
        <Slider x:Name="PanSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Pan}"
                TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" IsEnabled="{Binding CanPan}"
                a:AutomationProperties.Name="Track stereo balance" ToolTip.Tip="Left −1 · Center 0 · Right +1" />
        <TextBlock Grid.Column="2" Text="{Binding BalanceText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <Thumb x:Name="TrackResizeGrip" Classes="trackResize" Grid.Row="1" Cursor="SizeNorthSouth" Background="{DynamicResource InspectorDivider}"
           a:AutomationProperties.Name="Resize track height" ToolTip.Tip="Drag to resize this track">
      <Thumb.Template>
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Height="2" VerticalAlignment="Bottom" Background="{TemplateBinding Background}" />
          </Border>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
    </Grid>
  </Border>
</UserControl>
